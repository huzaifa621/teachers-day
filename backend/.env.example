# Server
PORT=4173
NODE_ENV=development

# Frontend origin allowed to call this API with credentials (comma-separate multiple)
FRONTEND_ORIGIN=http://localhost:3000

# The real domain students/faculty use — always this, regardless of where an
# admin happens to be browsing from. Used to build every shareable tribute
# link, the CSV export, and LinkedIn post links (see routes/faculty.js).
# In production, set this to the deployed domain, e.g. https://gratitudetoteachers.com
PUBLIC_SITE_URL=http://localhost:3001

# Session
SESSION_SECRET=
ADMIN_PASSWORD=

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=teachers_day

# S3 Storage — credentials come from the default AWS provider chain (EC2
# instance role in production; ~/.aws/credentials or AWS_ACCESS_KEY_ID +
# AWS_SECRET_ACCESS_KEY env vars for local dev), not from this file.
AWS_REGION=
S3_BUCKET=teachers-day-uploads
