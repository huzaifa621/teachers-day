# Root .env for docker-compose (backend reads this via env_file — see docker-compose.yml).
# Copy to .env and fill in real values. Never commit the real .env.

# Server
NODE_ENV=production
PORT=4173

# CORS is effectively unused once Nginx makes frontend+backend same-origin,
# but harmless to set correctly anyway — set to your real domain.
FRONTEND_ORIGIN=https://tributes.yourdomain.com

# Session
SESSION_SECRET=
ADMIN_PASSWORD=

# MongoDB (Atlas — unchanged)
MONGODB_URI=
MONGODB_DB_NAME=teachers_day

# S3 Storage
AWS_REGION=
S3_BUCKET=

# Only needed for local `docker compose up` testing, where there's no EC2
# instance role to fall back on. Leave unset in production on EC2 — the
# instance role (see deployment.md Step 3) is how the backend authenticates
# there instead, and static keys should not exist on the server at all.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
